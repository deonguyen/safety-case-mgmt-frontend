FROM node:26-alpine AS base

# 1. Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat
RUN apk add --no-cache wget
RUN apk add --no-cache curl
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

# 2. Rebuild the source code
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Remove all environment files copied over from the host
# RUN rm -f .env*

# Accept custom env file name as a build argument
ARG ENV_FILE=.env.stage
COPY ${ENV_FILE} .env.stage

# Run the stage build script
RUN npm run build:stage

# 3. Production image, copy all the files and run next
FROM base AS runner
# Ensure curl or wget is installed in your production base image (e.g., alpine)
RUN apk add --no-cache wget
RUN apk add --no-cache curl
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

# Automatically leverage output traces to reduce image size
RUN mkdir .next
RUN chown nextjs:nodejs .next

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3002
CMD ["env", "HOSTNAME=0.0.0.0", "PORT=3002", "node", "server.js"]
